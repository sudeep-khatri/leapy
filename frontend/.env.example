# LipiAI Frontend Environment Variables
# Copy this file to .env and fill in values

# URL of the LipiAI backend server (no trailing slash)
# When running locally: http://localhost:5001
# The frontend appends /api/chat, /api/analyze etc. to this base URL
VITE_LIPIAI_CHAT_URL=http://localhost:5001

# FastAPI image analysis endpoint (start ml/main.py with Uvicorn on port 8000)
VITE_LIPIAI_ANALYSIS_URL=http://localhost:8000/api/digitize
