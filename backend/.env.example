# -------------------------------------------------------------------
# LipiAI Backend — copy this file to .env and fill in your values
# -------------------------------------------------------------------

# Google Gemini API key
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use
# Options: models/gemini-3.5-flash, models/gemini-3.8-flash
GEMINI_MODEL=models/gemini-3.5-flash

# Port to run the backend on (default: 5001)
PORT=5001

# Allowed frontend origin for CORS (set to your frontend URL in production)
FRONTEND_ORIGIN=http://localhost:3000
