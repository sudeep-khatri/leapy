# Google Gemini API key
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model for chat replies (needs to be good quality)
GEMINI_MODEL=models/gemini-3.5-flash

# Model for translation calls — lite is faster and uses less quota
GEMINI_TRANSLATE_MODEL=models/gemini-flash-lite-latest

# Port to run the backend on (default: 5001)
PORT=5001

# Allowed frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:3000